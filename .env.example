OPENROUTER_API_KEY=sk-or-v1-...

# Tailnet path for this mini-app.
# Keep it simple: /bookcompressor
NEXT_PUBLIC_BASE_PATH=/bookcompressor

# Default host-managed inference runtime.
BOOK_COMPRESSOR_INFERENCE_PROVIDER=hermes
# BOOK_COMPRESSOR_HERMES_BIN=/home/you/.local/bin/hermes

