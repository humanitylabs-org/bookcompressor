# Tailnet path for this mini-app.
# Keep it simple: /bookcompressor
NEXT_PUBLIC_BASE_PATH=/bookcompressor

# Agent/model runtime. Defaults to auto, which tries:
# custom agent command -> Hermes CLI -> OpenClaw CLI -> OpenRouter.
# Recommended on Hermes VPS hosts: leave auto enabled, or set hermes explicitly.
BOOK_COMPRESSOR_INFERENCE_PROVIDER=auto
# BOOK_COMPRESSOR_INFERENCE_PROVIDER=hermes

# Hermes options (optional)
# BOOK_COMPRESSOR_HERMES_PROVIDER=openrouter
# BOOK_COMPRESSOR_AI_TIMEOUT_MS=300000

# OpenClaw option (optional)
# BOOK_COMPRESSOR_INFERENCE_PROVIDER=openclaw

# OpenRouter option (optional)
# BOOK_COMPRESSOR_INFERENCE_PROVIDER=openrouter
# BOOK_COMPRESSOR_OPENROUTER_DEFAULT_MODEL=anthropic/claude-haiku-4.5
# OPENROUTER_API_KEY=***
# Optional aliases accepted by the server key resolver:
# OPENROUTER_KEY=
# OPENROUTER_API_TOKEN=
# AI_API_KEY=
# LLM_API_KEY=

# Custom agent command option (works with any CLI that can take a prompt)
# BOOK_COMPRESSOR_INFERENCE_PROVIDER=agent-command
# BOOK_COMPRESSOR_AGENT_COMMAND=my-agent
# BOOK_COMPRESSOR_AGENT_ARGS='["run", "--prompt", "{prompt}"]'
# BOOK_COMPRESSOR_AGENT_OUTPUT_MODE=stdout
